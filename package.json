{
  "name": "ascii-studio",
  "productName": "ASCII Studio",
  "version": "1.1.0",
  "description": "Turn photos, videos and your camera into colourful ASCII art, with live ASCII desktop wallpapers.",
  "main": "app/main.js",
  "homepage": "https://github.com/zkp6c4vr89-coder/ascii-studio-desktop",
  "author": {
    "name": "ASCII Studio",
    "email": "zkp6c4vr89-coder@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "sync": "python3 sync_web.py",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.zkp6c4vr89coder.asciistudio",
    "productName": "ASCII Studio",
    "artifactName": "ASCII-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "app/**",
      "web/**",
      "package.json",
      "!web/wallpaper.html"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "ASCII Studio uses your camera only while you switch it on, to draw you as live ASCII art. Nothing leaves your Mac.",
        "NSAppleEventsUsageDescription": "ASCII Studio asks System Events to set your desktop picture when you choose Set as still wallpaper."
      }
    },
    "dmg": {
      "title": "ASCII Studio ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "ASCII Studio <zkp6c4vr89-coder@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
